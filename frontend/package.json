{
  "version": "1.0.0",
  "source": "./index.html",
  "type": "module",
  "name": "anima-project",
  "description": "A React project automatically generated by Anima using the Shadcn UI library",
  "scripts": {
    "dev": "vite",
    "build": "vite build && ./create-health.sh",
    "build:railway": "vite build && echo '{\"status\":\"healthy\",\"service\":\"neptunize-frontend\",\"timestamp\":\"'$(date -u +%Y-%m-%dT%H:%M:%SZ)'\"}' > dist/health.json",
    "start": "serve dist -s -p 8080",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "2.1.1",
    "lucide-react": "^0.453.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.1",
    "tailwind-merge": "2.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.24.0",
    "globals": "15.12.0",
    "serve": "^14.2.4",
    "tailwindcss": "3.4.16",
    "vite": "6.0.4",
    "vite-plugin-pwa": "^1.0.1"
  },
  "alias": {
    "@/*": "./src/components/ui/$1"
  }
}
